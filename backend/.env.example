# ─── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth (required) ──────────────────────────────────────────────────
# The server refuses to start without this. Use a long random value,
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ─── Server / public URLs ─────────────────────────────────────────────
PORT=5000
# Used to build customer-facing links in emails and WhatsApp messages.
FRONTEND_URL=http://localhost:5173
# Used to build absolute URLs for locally uploaded images.
BACKEND_URL=http://localhost:5000

# ─── Payments (optional — mocked when unset) ──────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# When set, incoming Razorpay webhooks MUST carry a valid signature.
RAZORPAY_WEBHOOK_SECRET=

# ─── Email (optional — falls back to an Ethereal test inbox) ──────────
EMAIL_USER=
EMAIL_PASS=
BREVO_API_KEY=

# ─── WhatsApp Cloud API (optional — logged to console when unset) ─────
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# ─── Images (optional — falls back to local /uploads storage) ─────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── AI (optional — mocked when unset) ────────────────────────────────
GEMINI_API_KEY=
